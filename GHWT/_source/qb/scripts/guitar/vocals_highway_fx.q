script vocals_bolt_effect 
	Obj_GetID
	Wait <start_delay> seconds
	CreateScreenElement {
		type = ContainerElement
		parent = <ObjID>
		pos = (0.0, 0.0)
		scale = (1.0, 1.0)
		just = [left center]
		pos_anchor = [left center]
		alpha = 0
	}
	<rot_id> = <id>
	CreateScreenElement {
		type = SpriteElement
		pos = (10.0, 0.0)
		texture = VH_Lightning_fx
		parent = <rot_id>
		just = [left center]
		pos_anchor = [left center]
	}
	<bolt_id> = <id>
	begin
	<rot_id> :SE_SetProps rot_angle = RandomFloat (0.0, 360.0) scale = (0.0, 0.0)
	<rot_id> :SE_SetProps alpha = 1 time = 0.05 scale = (1.0, 1.0) Anim = fast_out
	<rot_id> :SE_WaitProps
	<rot_id> :SE_SetProps alpha = 0 time = 0.15 Anim = fast_in
	<rot_id> :SE_WaitProps
	Wait RandomFloat (0.15, 0.25) seconds
	repeat
endscript
vocal_sp_bolts = 3

script vocals_paint_star_power_on \{player = 1}
	FormatText checksumname = fx_id 'vocals_sp_lightning_fx_%p' p = <player>
	DestroyScreenElement id = <fx_id>
	CreateScreenElement {
		type = ContainerElement
		id = <fx_id>
		parent = <parent>
		pos = (0.0, 0.0)
		scale (0.4, 0.4)
		z_priority = 19.0
		alpha = 1.0
		just = [center center]
		pos_anchor = [center center]
	}
	<delay> = 0.0
	begin
	RunScriptOnScreenElement id = <fx_id> vocals_bolt_effect params = {start_delay = <delay> anim_time = 0.01}
	<delay> = (<delay> + 0.2)
	repeat ($vocal_sp_bolts)
endscript

script vocals_paint_star_power_off \{player = 1}
	FormatText checksumname = fx_id 'vocals_sp_lightning_fx_%p' p = <player>
	DestroyScreenElement id = <fx_id>
endscript
