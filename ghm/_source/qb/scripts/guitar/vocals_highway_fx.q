script 0x86042438 
	obj_getid
	wait <start_delay> seconds
	createscreenelement {
		type = containerelement
		parent = <objid>
		pos = (0.0, 0.0)
		scale = (1.0, 1.0)
		just = [left center]
		pos_anchor = [left center]
		alpha = 0
	}
	<0x6ee839e3> = <id>
	createscreenelement {
		type = spriteelement
		pos = (10.0, 0.0)
		texture = 0x19b798e8
		parent = <0x6ee839e3>
		just = [left center]
		pos_anchor = [left center]
	}
	<0xa6877167> = <id>
	begin
	<0x6ee839e3> :se_setprops rot_angle = RandomFloat (0.0, 360.0) scale = (0.0, 0.0)
	<0x6ee839e3> :se_setprops alpha = 1 time = 0.05 scale = (1.0, 1.0) anim = fast_out
	<0x6ee839e3> :se_waitprops
	<0x6ee839e3> :se_setprops alpha = 0 time = 0.15 anim = fast_in
	<0x6ee839e3> :se_waitprops
	wait RandomFloat (0.15, 0.25) seconds
	repeat
endscript
0xcd867dcb = 3

script vocals_paint_star_power_on \{player = 1}
	formattext checksumname = fx_id 'vocals_sp_lightning_fx_%p' p = <player>
	destroyscreenelement id = <fx_id>
	createscreenelement {
		type = containerelement
		id = <fx_id>
		parent = <parent>
		pos = (0.0, 0.0)
		scale (0.4, 0.4)
		z_priority = 19.0
		alpha = 1.0
		just = [center center]
		pos_anchor = [center center]
	}
	<delay> = 0.0
	begin
	runscriptonscreenelement id = <fx_id> 0x86042438 params = {start_delay = <delay> anim_time = 0.01}
	<delay> = (<delay> + 0.2)
	repeat ($0xcd867dcb)
endscript

script vocals_paint_star_power_off \{player = 1}
	formattext checksumname = fx_id 'vocals_sp_lightning_fx_%p' p = <player>
	destroyscreenelement id = <fx_id>
endscript
